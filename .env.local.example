# Supabase — URL no botão Connect; chaves em Project Settings → API Keys
# Use anon/service_role (legado) OU publishable/secret (sb_publishable_ / sb_secret_)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role-ou-secret
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
INVITE_SECRET=mude-antes-de-publicar
# Sprint 4 — SaaS
# E-mails com acesso ao painel /admin (separados por vírgula)
SUPER_ADMIN_EMAILS=seu-email-real@exemplo.com
